# XEDO - Digital Risk Intelligence & Protection Platform
# Environment Configuration Example

PROJECT_NAME=XEDO
PROJECT_TAGLINE="Detect. Connect. Predict. Protect."
ENVIRONMENT=development

# Security & Authentication
SECRET_KEY=replace-with-a-unique-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default: Local SQLite for zero-config startup
DATABASE_URL=sqlite:///./xedo.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://xedo_user:xedo_password@localhost:5432/xedo_db

# Optional AI LLM API Keys (Supports Gemini & OpenAI with automatic deterministic fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server & Network
HOST=127.0.0.1
PORT=8000
FRONTEND_PORT=5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:3000
